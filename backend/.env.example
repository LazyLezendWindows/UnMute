NODE_ENV=development
PORT=5000
MIN_AGE=18

# Comma-separated browser origins allowed to call the API with credentials (required in production)
CORS_ORIGIN=http://localhost:5173

# OAuth 2.0 Web client ID from Google Cloud Console (same value as frontend VITE_GOOGLE_CLIENT_ID).
# Google ID tokens are verified against this audience; Google sign-in is disabled when empty.
GOOGLE_CLIENT_ID=

# Server-side session lifetime (HttpOnly cookie)
SESSION_TTL_DAYS=30

# Development only: seed demo accounts into an empty database (ignored in production)
SEED_DEMO_USERS=false

# MariaDB Configuration
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=unmute_db
MARIADB_SOCKET=
