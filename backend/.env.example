NODE_ENV=development
PORT=5000
MIN_AGE=18

# Reverse-proxy hops in front of the API (e.g. 1 behind a single load balancer); 0 when exposed directly
TRUST_PROXY=0

# Comma-separated browser origins allowed to call the API with credentials (required in production)
CORS_ORIGIN=http://localhost:5173

# OAuth 2.0 Web client ID from Google Cloud Console (Credentials → OAuth client ID → Web application,
# with http://localhost:5173 under Authorized JavaScript origins). The frontend fetches it from
# /api/v1/auth/config; ID tokens are verified against it. Google sign-in is disabled when empty.
GOOGLE_CLIENT_ID=

# Hosts profile photos may be loaded from (comma-separated; a leading dot also allows subdomains).
# Arbitrary photo URLs would let a member log the IP address of everyone who views their profile.
AVATAR_URL_HOSTS=.googleusercontent.com

# Deleting an account requires a session created within this many minutes (otherwise sign in again)
RECENT_AUTH_MINUTES=15

# Server-side session lifetime (HttpOnly cookie)
SESSION_TTL_DAYS=30

# "lax" for the web app (also with the native apps, which authenticate with a bearer token).
SESSION_COOKIE_SAMESITE=lax

# Capacitor app origins (https://localhost for Android, capacitor://localhost for iOS). Requests from
# these origins also receive the session token so the apps can store it securely; empty disables
# native sessions. These origins are added to CORS_ORIGIN automatically.
NATIVE_APP_ORIGINS=

# iOS OAuth client ID (Google Cloud Console → Credentials → iOS), accepted as a second token audience
# for the native iOS app. Optional.
GOOGLE_IOS_CLIENT_ID=

# New accounts with email + password. Unset: allowed in development, disabled in production, where
# accounts are created with Google (Unmute sends no email, so it cannot verify addresses itself).
# Existing password accounts can always sign in.
ALLOW_PASSWORD_SIGNUP=

# Profile photo uploads (free Cloudinary account, no card needed): copy "API environment variable"
# from the Cloudinary dashboard, cloudinary://<api key>:<api secret>@<cloud name>. Secret: keep it
# out of the repo. Empty disables uploads (members then keep their Google photo).
CLOUDINARY_URL=

# Chat requests (messaging someone you have not matched with). All optional; defaults shown.
# Length of the one introductory message, open requests a member may have at once, new requests
# per 24 hours, and days before someone whose request was declined may ask the same person again.
CHAT_REQUEST_MESSAGE_MAX=500
CHAT_REQUEST_MAX_PENDING=20
CHAT_REQUESTS_PER_DAY=30
CHAT_REQUEST_DECLINE_COOLDOWN_DAYS=7

# Web Push notifications (new messages and matches while the app is closed). Free: no third-party
# account. Generate the pair once with `npx web-push generate-vapid-keys` and keep the private key
# secret; changing the keys invalidates existing subscriptions. VAPID_SUBJECT is a mailto: or https
# contact for push services. Leave empty to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Push services subscription endpoints may point at (leading dot = subdomains). The defaults cover
# Chrome/Edge/Android (FCM), Firefox, Safari/iOS and Windows.
PUSH_ENDPOINT_HOSTS=

# Development only: seed demo accounts into an empty database (ignored in production)
SEED_DEMO_USERS=false

# MariaDB Configuration
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=unmute_db
MARIADB_SOCKET=
