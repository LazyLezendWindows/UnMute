{
  "name": "unmute-backend",
  "version": "1.0.0",
  "description": "Backend API and real-time service for Unmute",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "bash scripts/start-mariadb.sh && tsx watch src/server.ts",
    "test": "vitest run",
    "seed": "tsx src/utils/seed.ts",
    "migrate": "tsx src/config/migrate.ts",
    "migrate:prod": "node dist/config/migrate.js",
    "import:data": "tsx src/importers/cli.ts",
    "import:data:prod": "node dist/importers/cli.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "mysql2": "^3.24.4",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "@types/supertest": "^6.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
