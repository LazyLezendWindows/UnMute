# Optional: normally the Google client ID comes from the backend (GOOGLE_CLIENT_ID via /auth/config).
# Set this only to override it at build time; it must match the backend's value.
VITE_GOOGLE_CLIENT_ID=

# API base URL; defaults to /api/v1 (proxied to the backend by Vite in development).
# Native (Capacitor) builds must use an absolute HTTPS URL, e.g. https://api.example.com/api/v1;
# Socket.IO connects to the same origin.
VITE_API_URL=
